# Railway / 로컬 공통 예시 (main_instagram.py 워커)

# 워커가 main() 한 사이클 실행 후 대기하는 초 단위 간격 (슬롯·오프슬롯 이슈 재검사 주기)
CHECK_INTERVAL=1800

# 운영 시 false 권장 — true면 API 호출 전 6h 캐시만 쓰는 구간이 생길 수 있음(비용 절감용)
USE_CACHED_NEWS=false

# Telegram 저장 채널 (단일 카드뉴스 1장 또는 텍스트 브리핑)
ENABLE_TELEGRAM_STORAGE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=

# 뉴스 API (Railway 변수로 추가) — 없으면 news.py는 캐시/빈 목록에 의존할 수 있음
NEWS_API_KEY=

# 브리핑 모드
TEXT_BRIEFING_ONLY=true
# true: 1장 카드 JPEG 우선 전송 / false: 긴 텍스트 브리핑만
TELEGRAM_SINGLE_CARD=true
# 기사 썸네일(urlToImage) 배경 — NewsAPI는 이미지가 기사와 안 맞는 경우가 많아 기본 false 권장
TELEGRAM_CARD_USE_NEWS_IMAGE=false
# 카드 레이아웃: photo(BoA/삼성형) | badge(IREN형) | quote(HipHub형)
CARD_TEMPLATE=photo
# photo 템플릿 상단 좌측 작은 라벨 (비우면 생략)
# CARD_TOP_LEFT_LABEL=space go
# 한글 타이틀 퀄리티용 (Railway Linux에서 권장: Noto Sans KR 등 절대경로)
# CARD_FONT_PATH=/app/fonts/NotoSansKR-Regular.otf
CARD_BRAND_LABEL=MARKET CARD

CARD_NEWS_MODE=false
# briefing | market_fact | auto (아침 슬롯=브리핑 톤, 저녁=저장형 톤 — 코드에서 요약 엔진으로 매핑됨)
CONTENT_MODE=auto
FORCE_REGULAR_NOW=false
# 정규 전송 허용 분 폭(KST 08:10·19:10 시작). 기본 120 — 30분마다 워커여도 슬롯을 놓치지 않게
# REGULAR_POST_MINUTE_WINDOW=120
FORCE_CARD_TEST=false
# 신호 기반 전송(기본 true): KST 슬롯 무시, 점수·쿨다운·URL중복만 적용. 아침/저녁 분리 없음
SIGNAL_DRIVEN_SEND=true
# OFF_SCHEDULE_MIN_SCORE=58
# OFF_SCHEDULE_COOLDOWN_MINUTES=40
CARD_SEND_DEDUP_HOURS=20
SKIP_BREAKING_CHECK=true
DRY_RUN=false
DRY_RUN_PIPELINE=false

# Deprecated / unused in current policy (keep commented)
# STATIC_REEL_MODE=
# STATIC_REEL_FORMAT=
# ENABLE_INSTAGRAM_UPLOAD=
# ENABLE_OPENAI_IMAGE=
# ENABLE_OPENAI_STATIC_IMAGE=
# FORCE_REGENERATE_STATIC_BG=
# OPENAI_API_KEY=
# USE_REEL_STORY_V2=
# USE_CACHED_NEWS=
# SKIP_POLYMARKET=
