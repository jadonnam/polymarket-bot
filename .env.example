# Railway / 로컬 공통 예시 (main_instagram.py 워커)

# 워커가 main() 한 사이클 실행 후 대기하는 초 단위 간격 (슬롯·오프슬롯 이슈 재검사 주기)
CHECK_INTERVAL=1800

# 운영 시 false 권장 — true면 6h 캐시를 쓰며, 이제 기사별 publishedAt·URL연도도 다시 검사함
USE_CACHED_NEWS=false

# Telegram 저장 채널 (단일 카드뉴스 1장 또는 텍스트 브리핑)
ENABLE_TELEGRAM_STORAGE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=

# 뉴스 API (Railway 변수로 추가) — 없으면 news.py는 캐시/빈 목록에 의존할 수 있음
NEWS_API_KEY=

# 브리핑 모드 — 이슈 통과 시 BoA형 카드 JPEG + 캡션 텔레그램 전송
TEXT_BRIEFING_ONLY=true
TELEGRAM_SEND_DESK_BRIEFING=false
TELEGRAM_SINGLE_CARD=true
TELEGRAM_CARD_DELIVERY=render
# prompt=ChatGPT 이미지용 긴 프롬프트만 (JPEG 안 만듦)
OPENAI_API_KEY=
TELEGRAM_SKIP_CARD_WITHOUT_FONT=true
# DESK_BRIEFING_BRAND=자돈남 DESK
# 인스타 자동 업로드: 사용 안 함 (수동 게시)
# 단일 카드는 photo(BoA) 고정 — badge/quote는 무시됨
CARD_TEMPLATE=photo
# photo: ref_photo_bank.png + fallbacks (urlToImage 미사용)
TELEGRAM_CARD_USE_NEWS_IMAGE=false
# 한글 2줄 카피 (레퍼런스 문장형) — OPENAI_API_KEY 있으면 auto
# CARD_HEADLINE_OPENAI=auto
# photo 하단 출처 텍스트 (레퍼런스에는 없음 — 기본 false)
# CARD_PHOTO_SHOW_SOURCE=false
# CARD_WATERMARK_PATH=assets/branding/watermark.png
# urlToImage 추가 차단(쉼표, 소문자). 기본값에 tradingview·chart 등 포함됨
# TELEGRAM_CARD_REJECT_IMAGE_SUBSTR=
# 단일 카드 후보 최대 기사 나이(시간). 기본 48
# SINGLE_CARD_MAX_ARTICLE_AGE_HOURS=48
# 캡션: 이미지에 본문이 있으므로 기본 짧게(제목+원문). 긴 설명은 TELEGRAM_CAPTION_MINIMAL=false
TELEGRAM_CAPTION_MINIMAL=true
# (구) badge/quote — 단일 카드 운영 시 photo만 사용
# 상단 소형 라벨(BoA의 space go 등). photo 템플릿 권장
# CARD_TOP_LEFT_LABEL=space go
# 비우면 photo에서 상단 브랜드 생략(badge/quote는 각각 기본 라벨 사용)
# CARD_BRAND_LABEL=
# 한글 카드 Linux: Noto CJK (nixpacks fonts-noto-cjk 설치 후)
# CARD_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.otf

CARD_NEWS_MODE=false
# briefing | market_fact | auto (아침 슬롯=브리핑 톤, 저녁=저장형 톤 — 코드에서 요약 엔진으로 매핑됨)
CONTENT_MODE=auto
FORCE_REGULAR_NOW=false
# 정규 전송 허용 분 폭(KST 08:10·19:10 시작). 기본 120 — 30분마다 워커여도 슬롯을 놓치지 않게
# REGULAR_POST_MINUTE_WINDOW=120
FORCE_CARD_TEST=false
# 신호 기반 전송(기본 true): KST 슬롯 무시, 점수·쿨다운·URL중복만 적용. 아침/저녁 분리 없음
SIGNAL_DRIVEN_SEND=true
# OFF_SCHEDULE_ISSUE_ENABLED: 슬롯 모드(SIGNAL_DRIVEN_SEND=false)에서만 오프슬롯 이슈 on/off. 신호 모드에서는 평가에 쓰이지 않음.
# OFF_SCHEDULE_ISSUE_ENABLED=true
# OFF_SCHEDULE_MIN_SCORE=58
# OFF_SCHEDULE_COOLDOWN_MINUTES=40
CARD_SEND_DEDUP_HOURS=20
SKIP_BREAKING_CHECK=true
DRY_RUN=false
DRY_RUN_PIPELINE=false

# Deprecated / unused in current policy (keep commented)
# STATIC_REEL_MODE=
# STATIC_REEL_FORMAT=
# ENABLE_INSTAGRAM_UPLOAD=
# ENABLE_OPENAI_IMAGE=
# ENABLE_OPENAI_STATIC_IMAGE=
# FORCE_REGENERATE_STATIC_BG=
# OPENAI_API_KEY=
# 카드/캡션 한글 헤드라인: OPENAI_API_KEY 있으면 기본 on(auto). 끄려면 false.
# CARD_HEADLINE_OPENAI=auto
# OPENAI_HEADLINE_MODEL=gpt-4o-mini
# USE_REEL_STORY_V2=
# USE_CACHED_NEWS=
# SKIP_POLYMARKET=
